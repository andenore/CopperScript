{
  "name": "CopperScript",
  "scopeName": "source.copper",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#properties"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#types"
    },
    {
      "include": "#references"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#quantities"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#identifiers"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.copper",
          "match": "//.*$"
        },
        {
          "name": "comment.line.number-sign.copper",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.copper",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.copper"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.copper"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.copper",
          "match": "\\\\[\"\\\\nt]"
        },
        {
          "name": "invalid.illegal.escape.copper",
          "match": "\\\\."
        }
      ]
    },
    "properties": {
      "name": "variable.other.property.copper",
      "match": "(?<![\\p{L}\\p{N}_-])[\\p{L}_][\\p{L}\\p{N}_-]*(?=\\s*=)"
    },
    "declarations": {
      "patterns": [
        {
          "match": "(?<![\\p{L}\\p{N}_-])(board|part|device|board_profile)\\s+([\\p{L}_][\\p{L}\\p{N}_-]*)(?![\\p{L}\\p{N}_-])",
          "captures": {
            "1": {
              "name": "storage.type.copper"
            },
            "2": {
              "name": "entity.name.type.copper"
            }
          }
        },
        {
          "match": "(?<![\\p{L}\\p{N}_-])(component|module|net|supply|interface|port|pin|pad|peripheral|power_domain|resource|unit|group|mode_group|pad_set)\\s+([\\p{L}_][\\p{L}\\p{N}_-]*)(?![\\p{L}\\p{N}_-])",
          "captures": {
            "1": {
              "name": "storage.type.copper"
            },
            "2": {
              "name": "variable.other.definition.copper"
            }
          }
        },
        {
          "match": "(?<![\\p{L}\\p{N}_-])(constraint)\\s+([\\p{L}_][\\p{L}\\p{N}_-]*)(?![\\p{L}\\p{N}_-])",
          "captures": {
            "1": {
              "name": "storage.type.copper"
            },
            "2": {
              "name": "entity.name.function.copper"
            }
          }
        }
      ]
    },
    "types": {
      "match": "(:)\\s*([\\p{L}_][\\p{L}\\p{N}_-]*(?:\\.[\\p{L}_][\\p{L}\\p{N}_-]*)*)(?![\\p{L}\\p{N}_-])",
      "captures": {
        "1": {
          "name": "punctuation.separator.type.copper"
        },
        "2": {
          "name": "entity.name.type.copper"
        }
      }
    },
    "references": {
      "name": "variable.other.member.copper",
      "match": "(?<![\\p{L}\\p{N}_-])[\\p{L}_][\\p{L}\\p{N}_-]*(?:\\.(?:[\\p{L}_][\\p{L}\\p{N}_-]*|[0-9]+))+(?![\\p{L}\\p{N}_-])"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.import.copper",
          "match": "(?<![\\p{L}\\p{N}_-])(?:import|use|library|as)(?![\\p{L}\\p{N}_-])"
        },
        {
          "name": "storage.type.copper",
          "match": "(?<![\\p{L}\\p{N}_-])(?:board|module|part|device|board_profile|component|net|supply|interface|constraint|configure|power_state|port|pin|pad|peripheral|power_domain|mux|resource|unit|group|mode_group|pad_set|route|signal|bind|mechanical|outline|cutout|hole|rules|keepout|copper_keepout|datum|edge|attach|overhang|component_height|enclosure|assembly_access|boundary|slot|reference|connector|stackup|copper|dielectric|silkscreen|branding|text|logo|line|rectangle|circle|arc|polygon)(?![\\p{L}\\p{N}_-])"
        }
      ]
    },
    "booleans": {
      "name": "constant.language.boolean.copper",
      "match": "(?<![\\p{L}\\p{N}_-])(?:true|false)(?![\\p{L}\\p{N}_-])"
    },
    "quantities": {
      "name": "meta.number.quantity.copper",
      "match": "(?<![\\p{L}\\p{N}_-])([+-]?)([0-9]+(?:\\.[0-9]+)?)(\\s*)(kohm|Mohm|ohm|kHz|MHz|GHz|mV|uF|nF|pF|mH|uH|nH|mm|um|mA|uA|Hz|V|F|H|m|A)(?![\\p{L}\\p{N}_-])",
      "captures": {
        "1": {
          "name": "keyword.operator.copper"
        },
        "2": {
          "name": "constant.numeric.copper"
        },
        "4": {
          "name": "storage.type.unit.copper"
        }
      }
    },
    "numbers": {
      "match": "(?<![\\p{L}\\p{N}_-])([+-]?)([0-9]+(?:\\.[0-9]+)?)",
      "captures": {
        "1": {
          "name": "keyword.operator.copper"
        },
        "2": {
          "name": "constant.numeric.copper"
        }
      }
    },
    "identifiers": {
      "name": "variable.other.copper",
      "match": "[\\p{L}_][\\p{L}\\p{N}_-]*"
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.block.copper",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.group.copper",
          "match": "[()]"
        },
        {
          "name": "punctuation.section.brackets.copper",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.separator.copper",
          "match": "[,;:]"
        },
        {
          "name": "punctuation.accessor.copper",
          "match": "\\."
        },
        {
          "name": "keyword.operator.copper",
          "match": "[-+=/]"
        }
      ]
    }
  }
}
