{
  "name": "copperscript",
  "displayName": "CopperScript",
  "description": "CopperScript syntax highlighting and language server, using the local copper binary",
  "version": "0.4.0",
  "publisher": "andenore",
  "license": "MIT",
  "icon": "media/copper-logo.png",
  "repository": {"type": "git", "url": "https://github.com/andenore/CopperScript.git"},
  "homepage": "https://github.com/andenore/CopperScript#readme",
  "bugs": {"url": "https://github.com/andenore/CopperScript/issues"},
  "categories": ["Programming Languages", "Other"],
  "keywords": ["copper", "copperscript", "pcb", "hardware", "language server"],
  "files": ["extension.cjs", "lsp-client.cjs", "compiler.cjs", "setup.cjs", "language-configuration.json", "README.md", "CHANGELOG.md", "LICENSE", "media/copper-logo.png", "syntaxes/**"],
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./extension.cjs",
  "activationEvents": [
    "onLanguage:copper"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {"command": "copperscript.showSetup", "title": "Show Setup", "category": "CopperScript"},
      {"command": "copperscript.restartLanguageServer", "title": "Restart Language Server", "category": "CopperScript"}
    ],
    "configuration": {
      "title": "CopperScript",
      "properties": {
        "copperscript.lsp.enabled": {
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "Enable CopperScript completion, hover, navigation and diagnostics in trusted local workspaces."
        },
        "copperscript.lsp.compilerCommand": {
          "scope": "resource",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": ["copper"],
          "description": "Argv of the copper binary, without the lsp subcommand, for example [\"/absolute/path/to/copper\"]. The extension starts <command...> lsp. The default runs copper from PATH; [] also selects the default. Never a shell string."
        }
      }
    },
    "grammars": [
      {"language": "copper", "scopeName": "source.copper", "path": "./syntaxes/copper.tmLanguage.json"}
    ],
    "languages": [
      {
        "id": "copper",
        "aliases": [
          "CopperScript",
          "copper"
        ],
        "extensions": [
          ".copper"
        ],
        "configuration": "./language-configuration.json"
      }
    ]
  }
}
