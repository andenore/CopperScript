// Project owns its outline and antenna cutout; CopperLib owns the host pattern.
board_profile CM4Carrier {
    import cm4 "github.com/andenore/CopperLib/packages/raspberry_pi_cm4";
    use cm4.CM4Mounting as module { gpio = gpio; high_speed = high_speed; }
    outline rectangle { width = 70mm; height = 70mm; }
    rules { minimum_track_width = 0.15mm; minimum_clearance = 0.15mm; }
    // CM4 internal antenna is at the bottom edge in this datum. This clearance
    // covers the datasheet's preferred 15x8 mm projection and extends to edge.
    // Keep all copper, vias, pads and components out on all four layers.
    copper_keepout cm4_antenna rectangle {
        origin = (18.5mm, 55mm); width = 15mm; height = 15mm;
        layers = "F.Cu,In1.Cu,In2.Cu,B.Cu";
        block_tracks = true; block_vias = true; block_pads = true;
        block_zones = true; block_footprints = true;
    }
}
