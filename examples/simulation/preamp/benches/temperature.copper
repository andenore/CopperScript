// The preamp (../board.copper) from -40 degC to 85 degC: param TEMP is
// stepped like any other param, and every part follows it.
//
// Offset (analysis op). At DC the output is (1 + R_F/R_G) (V_os - I_b R_B)
// + I_b R_F, -0.98 mV at 27 degC (benches/offset_worstcase.copper). The
// input offset drifts 0.2 uV/degC (an illustrative figure, as the part's
// others): 11 * 0.2 uV = 2.2 uV/degC at the output. R_B's 100 ppm/degC
// moves I_b R_B by 10 nV/degC (0.11 uV/degC at the output, the other way),
// the matched pair shares its tempco (the gain does not move) and the
// model's bias current does not drift: -0.98 mV - 2.09 uV/degC (27 degC -
// TEMP), -1.12 mV at -40 degC and -0.86 mV at 85 degC.
//
// Noise (analysis noise, at the bench temperature: no temperature of its
// own). Every resistor's thermal noise and the op-amp's voltage noise grow as
// sqrt(T): at 85 degC by sqrt(358.15 / 300.15) = 1.092, 67 nV/rtHz at the
// output at 27 degC becomes about 73 nV/rtHz. The current noise (a shot
// noise) stays.
bench TemperatureSweep for LowNoisePreamp {
    replace J_IN with source { out = J_IN.1; ref = GND; ac = 1mV; output_resistance = 1kohm; }
    ignore J_OUT, J_PWR;
    param TEMP = 27degC;
    step TEMP in -40degC, 27degC, 85degC;

    analysis offset: op;
    measure offset = V(VOUT) { min = -2.5mV; max = 2.5mV; }

    analysis noise: noise { from = 1Hz; to = 1MHz; points_per_decade = 10; output = V(VOUT); input = J_IN; }
    measure en_out_1khz = at(noise(), 1kHz) { max = 80nV/rtHz; }
    measure en_in_1khz = at(input_noise(), 1kHz) { max = 7.5nV/rtHz; }
    measure vn_audio = noise_rms(noise(), 10Hz, 20kHz) { max = 0.013mV; }
    measure gain_1khz = mag(at(V(VOUT) / V(J_IN.1), 1kHz));
    plot noise(), input_noise();
}
