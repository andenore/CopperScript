// The amplifier (../board.copper) at DC with 1 V in.
//
// The subcircuit's open-loop gain is 1e5 into its 10 ohm output resistance,
// which drives R_LOAD || (R_F + R_G) = 1.667 kohm: A = 1e5 * 1666.7 / 1676.7
// = 99404. With beta = R_G / (R_F + R_G) = 0.1 the output is
// A / (1 + A beta) = 9.99899 V. The model draws its 1.5 mA quiescent current
// and the output current, 9.999 V / 1666.7 ohm = 6.0 mA, from VP: 7.50 mA.
// Its inputs carry no DC current.
bench OperatingPoint for SpiceAmplifier {
    replace J_IN with source { out = J_IN.1; ref = GND; dc = 1V; }
    ignore J_OUT, J_PWR;
    analysis op;
    measure output = V(OUT) { min = 9.9985V; max = 9.9995V; }
    measure supply_current = I(U1.VP) { min = 7.49mA; max = 7.51mA; }
    measure negative_supply_current = I(U1.VN) { min = -1.51mA; max = -1.49mA; }
    measure input_current = I(U1.INP) { min = -1pA; max = 1pA; }
}
