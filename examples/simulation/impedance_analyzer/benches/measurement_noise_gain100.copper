// MeasurementNoiseGain100: noise of the gain-100 sense channel (ADC input V_MON_100) with the stake in soil,
// SoilModel at its three corners: 5 ohm m (R_TRANSFER 40 ohm, the smallest signal:
// 0.6 mV peak at the sense electrodes), 100 ohm m (800 ohm) and 1.3 kohm m (11 kohm),
// relative permittivity 25. A noise analysis has one output, so each ADC channel has
// its own bench: MeasurementNoiseGain1, MeasurementNoiseGain10, MeasurementNoiseGain100
// and MeasurementNoiseCurrent.
//
// Detection bandwidth: the firmware demodulates I and Q over whole periods; its noise
// bandwidth is taken as 1 kHz (SPEC.md, "Estimates the simulation must confirm"), the
// noise in a 1 kHz band centred on the drive frequency, 500 Hz to 1.5 kHz at 1 kHz. A
// longer record narrows the band: the noise falls with its square root. The signal is
// the drive's (DDS 0.3 V, 15 uA peak) at the same ADC input; SNR is its RMS over the
// band's noise RMS. Reported at 1 kHz, 10 kHz, 100 kHz and 1 MHz. Contributors are
// grouped and given as their share of the noise power in the band at 1 kHz and at
// 100 kHz; the HTML page ranks every contributor over the whole analysis band.
// No limits: SPEC.md sets no noise requirement (the resolution it implies is derived
// in README.md, "MeasurementNoise").
//
// Generators: thermal noise of every resistor, the soil's included (it is real noise
// at the electrodes), of the DDS's 200 ohm and of the bias resistors; each amplifier's
// voltage and current noise with its 1/f corner (parts/analog_*: the ADA4807 corners
// from its Table 2, the ADA4817 and AD8130 corners fitted to their noise figures,
// estimates). Not modelled: the AD8130's REF/FB current noise, the e_n times input
// capacitance current, the ADC's own noise, rail noise (ideal supplies).
// Channel: sense buffers, receiver at gain 1, U_G10 and U_G100 (gain 10.09 each).
bench MeasurementNoiseGain100 for AnalogFrontEnd using FrontEndPorts, SoilModel {
    analysis noise { from = 100Hz; to = 2MHz; points_per_decade = 20; output = V(V_MON_100); }
    step R_TRANSFER in 40ohm, 800ohm, 11kohm;

    // Referred to the soil's transfer voltage between the sense points.
    let referred = noise() / mag(V(V_MON_100) / V(S_HP, S_LP));
    measure signal_1khz = mag(at(V(V_MON_100), 1kHz));
    measure noise_1khz = noise_rms(noise(), 500Hz, 1.5kHz);
    measure snr_1khz = db(mag(at(V(V_MON_100), 1kHz)) / 1.41421356 / noise_rms(noise(), 500Hz, 1.5kHz));
    measure referred_density_1khz = at(referred, 1kHz);
    measure signal_10khz = mag(at(V(V_MON_100), 10kHz));
    measure noise_10khz = noise_rms(noise(), 9.5kHz, 10.5kHz);
    measure snr_10khz = db(mag(at(V(V_MON_100), 10kHz)) / 1.41421356 / noise_rms(noise(), 9.5kHz, 10.5kHz));
    measure referred_density_10khz = at(referred, 10kHz);
    measure signal_100khz = mag(at(V(V_MON_100), 100kHz));
    measure noise_100khz = noise_rms(noise(), 99.5kHz, 100.5kHz);
    measure snr_100khz = db(mag(at(V(V_MON_100), 100kHz)) / 1.41421356 / noise_rms(noise(), 99.5kHz, 100.5kHz));
    measure referred_density_100khz = at(referred, 100kHz);
    measure signal_1mhz = mag(at(V(V_MON_100), 1MHz));
    measure noise_1mhz = noise_rms(noise(), 999.5kHz, 1.0005MHz);
    measure snr_1mhz = db(mag(at(V(V_MON_100), 1MHz)) / 1.41421356 / noise_rms(noise(), 999.5kHz, 1.0005MHz));
    measure referred_density_1mhz = at(referred, 1MHz);
    measure share_sense_buffers_1khz = noise_share(noise(U_BHP), 500Hz, 1.5kHz) + noise_share(noise(U_BLP), 500Hz, 1.5kHz);
    measure share_receiver_1khz = noise_share(noise(U_DIF), 500Hz, 1.5kHz);
    measure share_adc_stages_1khz = noise_share(noise(U_G10), 500Hz, 1.5kHz) + noise_share(noise(R_G1B), 500Hz, 1.5kHz)
        + noise_share(noise(R_G1S), 500Hz, 1.5kHz) + noise_share(noise(R_G1F), 500Hz, 1.5kHz)
        + noise_share(noise(R_G1G), 500Hz, 1.5kHz) + noise_share(noise(U_G100), 500Hz, 1.5kHz)
        + noise_share(noise(R_G2B), 500Hz, 1.5kHz) + noise_share(noise(R_G2S), 500Hz, 1.5kHz)
        + noise_share(noise(R_G2F), 500Hz, 1.5kHz) + noise_share(noise(R_G2G), 500Hz, 1.5kHz)
        + noise_share(noise(R_AA100), 500Hz, 1.5kHz);
    measure share_soil_1khz = noise_share(noise(RC_HC), 500Hz, 1.5kHz) + noise_share(noise(RC_HP), 500Hz, 1.5kHz)
        + noise_share(noise(RT), 500Hz, 1.5kHz) + noise_share(noise(RC_LP), 500Hz, 1.5kHz)
        + noise_share(noise(RC_LC), 500Hz, 1.5kHz);
    measure share_drive_1khz = noise_share(noise(DDS), 500Hz, 1.5kHz) + noise_share(noise(R_TERM), 500Hz, 1.5kHz)
        + noise_share(noise(R_INB), 500Hz, 1.5kHz) + noise_share(noise(U_DRV), 500Hz, 1.5kHz)
        + noise_share(noise(U_PMP), 500Hz, 1.5kHz) + noise_share(noise(U_FBB), 500Hz, 1.5kHz)
        + noise_share(noise(RN_HOW), 500Hz, 1.5kHz) + noise_share(noise(R_SET), 500Hz, 1.5kHz);
    measure share_bias_resistors_1khz = noise_share(noise(R_BHP), 500Hz, 1.5kHz) + noise_share(noise(R_BLP), 500Hz, 1.5kHz);
    measure share_sense_buffers_100khz = noise_share(noise(U_BHP), 99.5kHz, 100.5kHz) + noise_share(noise(U_BLP), 99.5kHz, 100.5kHz);
    measure share_receiver_100khz = noise_share(noise(U_DIF), 99.5kHz, 100.5kHz);
    measure share_adc_stages_100khz = noise_share(noise(U_G10), 99.5kHz, 100.5kHz) + noise_share(noise(R_G1B), 99.5kHz, 100.5kHz)
        + noise_share(noise(R_G1S), 99.5kHz, 100.5kHz) + noise_share(noise(R_G1F), 99.5kHz, 100.5kHz)
        + noise_share(noise(R_G1G), 99.5kHz, 100.5kHz) + noise_share(noise(U_G100), 99.5kHz, 100.5kHz)
        + noise_share(noise(R_G2B), 99.5kHz, 100.5kHz) + noise_share(noise(R_G2S), 99.5kHz, 100.5kHz)
        + noise_share(noise(R_G2F), 99.5kHz, 100.5kHz) + noise_share(noise(R_G2G), 99.5kHz, 100.5kHz)
        + noise_share(noise(R_AA100), 99.5kHz, 100.5kHz);
    measure share_soil_100khz = noise_share(noise(RC_HC), 99.5kHz, 100.5kHz) + noise_share(noise(RC_HP), 99.5kHz, 100.5kHz)
        + noise_share(noise(RT), 99.5kHz, 100.5kHz) + noise_share(noise(RC_LP), 99.5kHz, 100.5kHz)
        + noise_share(noise(RC_LC), 99.5kHz, 100.5kHz);
    measure share_drive_100khz = noise_share(noise(DDS), 99.5kHz, 100.5kHz) + noise_share(noise(R_TERM), 99.5kHz, 100.5kHz)
        + noise_share(noise(R_INB), 99.5kHz, 100.5kHz) + noise_share(noise(U_DRV), 99.5kHz, 100.5kHz)
        + noise_share(noise(U_PMP), 99.5kHz, 100.5kHz) + noise_share(noise(U_FBB), 99.5kHz, 100.5kHz)
        + noise_share(noise(RN_HOW), 99.5kHz, 100.5kHz) + noise_share(noise(R_SET), 99.5kHz, 100.5kHz);
    measure share_bias_resistors_100khz = noise_share(noise(R_BHP), 99.5kHz, 100.5kHz) + noise_share(noise(R_BLP), 99.5kHz, 100.5kHz);
    plot noise(), referred;
}
