// 0603 thick-film resistor used as the series element of an RC supply post-filter, so
// ERC can follow the DC feed (dc_power_path) into the filtered rail. The value is set
// per component (1 ohm on this board). Orderable example for 1 ohm 1 %: Yageo
// RC0603FR-071RL (unverified: part number from the Yageo naming scheme, from memory;
// the 0.1 W rating must be checked against the Yageo RC_L series data sheet).
// Footprint: KiCad Resistor_SMD:R_0603_1608Metric.
part FEED_RESISTOR_0603 {
    category = "passive.resistor";
    footprint = "Resistor_SMD:R_0603_1608Metric";
    dc_power_path = "1,2";
    pin 1 { number = "1"; domains = "power"; directions = "passive"; }
    pin 2 { number = "2"; domains = "power"; directions = "passive"; }
}
