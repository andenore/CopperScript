// An illustrative environmental sensor part supplied by a reusable package.
part BME280 {
    category = "sensor.environmental";
    manufacturer = "Example Sensors";
    footprint = "LGA-8";

    pin VDD {
        number = "1";
        domains = "power";
        directions = "input";
        voltage_min = 1.71V;
        voltage_max = 3.6V;
    }
    pin GND {
        number = "2";
        domains = "ground";
        directions = "input";
    }
    pin SCL {
        number = "3";
        domains = "digital";
        directions = "bidirectional";
        drive_modes = "open_drain";
        voltage_min = 0V;
        voltage_max = 3.6V;
    }
    pin SDA {
        number = "4";
        domains = "digital";
        directions = "bidirectional";
        drive_modes = "open_drain";
        voltage_min = 0V;
        voltage_max = 3.6V;
    }
}
