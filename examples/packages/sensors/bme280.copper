// An illustrative environmental sensor part supplied by a reusable package.
part BME280 {
    kind = sensor;
    manufacturer = "Example Sensors";
    footprint = "LGA-8";

    pin VDD {
        number = "1";
        role = digital_supply;
        capabilities = "power_input";
        voltage_min = 1.71V;
        voltage_max = 3.6V;
    }
    pin GND {
        number = "2";
        role = ground;
        capabilities = "power_input";
    }
    pin SCL {
        number = "3";
        capabilities = "digital_input,open_drain_output";
        voltage_min = 0V;
        voltage_max = 3.6V;
    }
    pin SDA {
        number = "4";
        capabilities = "digital_input,open_drain_output";
        voltage_min = 0V;
        voltage_max = 3.6V;
    }
}
