// Illustrative package-specific bonding for an STM32-like LQFP-48 MCU.
part STM32G0B1CBT6 {
    kind = mcu;
    manufacturer = "STMicroelectronics";
    footprint = "LQFP-48";
    device = STM32G0B1;

    pin VDD {
        number = "24";
        bond = VDD;
        role = digital_supply;
        voltage_min = 1.7V;
        voltage_max = 3.6V;
    }
    pin VSS { number = "23"; bond = VSS; role = ground; }
    pin PA2 { number = "10"; bond = PA2; }
    pin PA3 { number = "11"; bond = PA3; }
    pin PB6 { number = "45"; bond = PB6; }
    pin PB7 { number = "46"; bond = PB7; }
}
