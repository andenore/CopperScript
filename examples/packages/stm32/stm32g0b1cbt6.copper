// Illustrative package-specific bonding for an STM32-like LQFP-48 MCU.
part STM32G0B1CBT6 {
    kind = mcu;
    manufacturer = "STMicroelectronics";
    footprint = "LQFP-48";
    device = STM32G0B1;

    pin VDD: power_in {
        number = "24";
        voltage_min = 1.7V;
        voltage_max = 3.6V;
    }
    pin VSS: power_in { number = "23"; }
    pin PA2: bidirectional { number = "10"; voltage_max = 3.6V; }
    pin PA3: bidirectional { number = "11"; voltage_max = 3.6V; }
    pin PB6: bidirectional { number = "42"; voltage_max = 3.6V; }
    pin PB7: bidirectional { number = "43"; voltage_max = 3.6V; }
}
