// Generated from device-data/stm32g0b1; do not edit by hand.
// Regenerate with: python tools/devicegen.py generate <bundle> --out-dir <package>
// Illustrative subset of the STM32G0B1 capability map.
// A production bundle should be generated and checked against vendor data.

device STM32G0B1 {
    vendor = "STMicroelectronics";
    family = "STM32G0";
    source_revision = "illustrative-v0.1";

    power_domain VDDIO1 {
        supply_pads = "VDD";
    }

    pad VDD {
        domains = "power";
        directions = "input";
    }

    pad VSS {
        domains = "ground";
        directions = "input";
    }

    pad PA2 {
        domains = "digital";
        directions = "bidirectional";
        drive_modes = "push_pull,open_drain";
        traits = "gpio";
        power_domain = VDDIO1;
        unpowered = clamped;
        voltage_max = 3.6V;
    }

    pad PA3 {
        domains = "digital";
        directions = "bidirectional";
        drive_modes = "push_pull,open_drain";
        traits = "gpio";
        power_domain = VDDIO1;
        unpowered = clamped;
        voltage_max = 3.6V;
    }

    pad PB6 {
        domains = "digital";
        directions = "bidirectional";
        drive_modes = "push_pull,open_drain";
        traits = "gpio";
        power_domain = VDDIO1;
        unpowered = clamped;
        voltage_max = 3.6V;
    }

    pad PB7 {
        domains = "digital";
        directions = "bidirectional";
        drive_modes = "push_pull,open_drain";
        traits = "gpio";
        power_domain = VDDIO1;
        unpowered = clamped;
        voltage_max = 3.6V;
    }

    peripheral I2C1: i2c {
        signal SDA: open_drain;
        signal SCL: open_drain;
    }

    peripheral USART2: uart {
        signal TX: output;
        signal RX: input;
        signal CK: output { required = false; }
    }

    resource USART2_REMAP;

    mux PB7: I2C1.SDA { selector = "AF6"; }
    mux PB6: I2C1.SCL { selector = "AF6"; }
    mux PA2: USART2.TX {
        selector = "AF1";
        resource = USART2_REMAP;
        setting = default;
    }
    mux PA3: USART2.RX {
        selector = "AF1";
        resource = USART2_REMAP;
        setting = default;
    }
    mux PB6: USART2.TX {
        selector = "AF0";
        resource = USART2_REMAP;
        setting = remapped;
    }
    mux PB7: USART2.RX {
        selector = "AF0";
        resource = USART2_REMAP;
        setting = remapped;
    }
}
