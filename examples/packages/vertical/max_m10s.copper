    source_url = "https://content.u-blox.com/sites/default/files/MAX-M10S_DataSheet_UBX-20035208.pdf";
    pin GND_1 { number = "1"; domains = "ground"; directions = "input"; }
    pin TXD { number = "2"; domains = "digital"; directions = "output"; drive_modes = "push_pull"; voltage_max = 3.6V; }
    pin RXD { number = "3"; domains = "digital"; directions = "input"; voltage_max = 3.6V; }
    pin TIMEPULSE { number = "4"; domains = "digital,clock"; directions = "output"; drive_modes = "push_pull"; voltage_max = 3.6V; }
    pin EXTINT { number = "5"; domains = "digital"; directions = "input"; voltage_max = 3.6V; connection = optional; }
    pin V_BCKP { number = "6"; domains = "power"; directions = "input"; voltage_min = 1.65V; voltage_max = 3.6V; }
    pin V_IO { number = "7"; domains = "power"; directions = "input"; voltage_min = 1.65V; voltage_max = 3.6V; }
    pin VCC { number = "8"; domains = "power"; directions = "input"; voltage_min = 1.76V; voltage_max = 3.6V; }
    pin RESET_N { number = "9"; domains = "digital"; directions = "input"; voltage_max = 3.6V; connection = optional; }
    pin GND_2 { number = "10"; domains = "ground"; directions = "input"; }
    pin RF_IN { number = "11"; domains = "rf"; directions = "input"; traits = "gnss_rf"; }
    pin GND_3 { number = "12"; domains = "ground"; directions = "input"; }
    pin LNA_EN { number = "13"; domains = "digital"; directions = "output"; drive_modes = "push_pull"; connection = optional; }
    pin VCC_RF { number = "14"; domains = "power"; directions = "output"; connection = optional; }
    pin VIO_SEL { number = "15"; domains = "digital"; directions = "input"; connection = do_not_connect; }
    pin SDA { number = "16"; domains = "digital"; directions = "bidirectional"; drive_modes = "open_drain"; connection = optional; }
    pin SCL { number = "17"; domains = "digital"; directions = "bidirectional"; drive_modes = "open_drain"; connection = optional; }
    pin SAFEBOOT_N { number = "18"; domains = "digital"; directions = "input"; connection = optional; }
