device NRF52832 {
    vendor = "Nordic Semiconductor";
    family = "nRF52";
    source_document = "nRF52832 Product Specification";
    source_revision = "v1.9";
    source_url = "https://docs.nordicsemi.com/r/bundle/ps_nrf52832";

    power_domain VDDIO { supply_pads = "VDD"; voltage_min = 1.7V; voltage_max = 3.6V; }
    pad VDD { domains = "power"; directions = "input"; voltage_min = 1.7V; voltage_max = 3.6V; }
    pad VSS { domains = "ground"; directions = "input"; }
    pad P0_06 { domains = "digital"; directions = "bidirectional"; drive_modes = "push_pull,open_drain"; traits = "gpio"; power_domain = VDDIO; voltage_max = 3.6V; }
    pad P0_08 { domains = "digital"; directions = "bidirectional"; drive_modes = "push_pull,open_drain"; traits = "gpio"; power_domain = VDDIO; voltage_max = 3.6V; }
    pad P0_21 { domains = "digital"; directions = "bidirectional"; drive_modes = "push_pull,open_drain"; traits = "gpio,reset"; power_domain = VDDIO; voltage_max = 3.6V; }
    pad SWDCLK { domains = "digital,clock"; directions = "input"; traits = "swdclk"; power_domain = VDDIO; voltage_max = 3.6V; }
    pad SWDIO { domains = "digital"; directions = "bidirectional"; drive_modes = "push_pull"; traits = "swdio"; power_domain = VDDIO; voltage_max = 3.6V; }
    pad ANT { domains = "rf"; directions = "passive"; traits = "antenna"; }

    peripheral UARTE0: uart { signal TX: output; signal RX: input; }
    mux P0_06: UARTE0.TX { selector = "PSEL.TXD=6"; }
    mux P0_08: UARTE0.RX { selector = "PSEL.RXD=8"; }
}
