    pin TXD { number = "1"; domains = "digital"; directions = "input"; voltage_max = 3.6V; }
    pin GND { number = "2"; domains = "ground"; directions = "input"; }
    pin VCC { number = "3"; domains = "power"; directions = "input"; voltage_min = 3V; voltage_max = 3.6V; }
    pin RXD { number = "4"; domains = "digital"; directions = "output"; drive_modes = "push_pull"; voltage_max = 3.6V; }
    pin SHDN { number = "5"; domains = "digital"; directions = "input"; voltage_max = 3.6V; }
    pin CANL { number = "6"; domains = "analog"; directions = "bidirectional"; traits = "can_bus"; }
    pin CANH { number = "7"; domains = "analog"; directions = "bidirectional"; traits = "can_bus"; }
    pin STB { number = "8"; domains = "digital"; directions = "input"; voltage_max = 3.6V; }
