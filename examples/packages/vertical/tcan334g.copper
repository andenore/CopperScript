part TCAN334G {
    category = "interface.can.transceiver";
    manufacturer = "Texas Instruments";
    footprint = "Package_SO:VSSOP-8_3.0x3.0mm_P0.65mm";
    source_document = "TCAN33x 3.3-V CAN Transceivers datasheet";
