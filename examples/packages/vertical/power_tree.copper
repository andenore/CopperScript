module FullVerticalPowerTree {
    use library "tiny";

    port VIN5: power_in;
    port GND: power_in;
    port V3V3: power_out;
    port V3V8: power_out;

    component U_LOGIC: REGULATOR_3V3 { footprint = "Package_TO_SOT_SMD:SOT-23"; }
    component U_MODEM: REGULATOR_3V8_2A;
    component C_5V: CAPACITOR { value = 100uF; footprint = "0603"; }
    component C_3V3: CAPACITOR { value = 22uF; footprint = "0603"; }
    component C_3V8: CAPACITOR { value = 100uF; footprint = "0603"; }

    net VIN5 { port.VIN5; U_LOGIC.IN; U_MODEM.VIN; U_MODEM.EN; C_5V.1; }
    net GND { port.GND; U_LOGIC.GND; U_MODEM.GND; C_5V.2; C_3V3.2; C_3V8.2; }
    net V3V3 { port.V3V3; U_LOGIC.OUT; C_3V3.1; }
    net V3V8 { port.V3V8; U_MODEM.OUT; C_3V8.1; }

    supply INPUT { voltage = 5V; net = VIN5; external = true; }
    supply LOGIC { voltage = 3.3V; net = V3V3; source = U_LOGIC.OUT; }
    supply MODEM { voltage = 3.8V; net = V3V8; source = U_MODEM.OUT; }
    supply GROUND { voltage = 0V; net = GND; external = true; }

    constraint max_distance(C_5V, U_MODEM.VIN) { distance = 3mm; }
    constraint max_distance(C_3V8, U_MODEM.OUT) { distance = 3mm; }
}
