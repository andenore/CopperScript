// USB-C 5-V input, always-on 3.3-V logic and MCU-enabled 3.8-V modem buck.
// The buck power stage follows TI's TPS62130A reference circuit. Input-budget,
// transient and thermal performance still require bench qualification.
module FullVerticalPowerTree {
    use library "tiny";
    import ti "github.com/andenore/CopperLib/packages/parts/ti/tps62130a";
    import coilcraft "github.com/andenore/CopperLib/packages/parts/coilcraft/xal4020";

    port VIN5: power_in;
    port GND: power_in;
    port MODEM_EN: input;
    port V3V3: power_out;
    port V3V8: power_out;

    component U_LOGIC: REGULATOR_3V3 { footprint = "Package_TO_SOT_SMD:SOT-23"; }
    component U_MODEM: ti.TPS62130ARGTR;
    component L_MODEM: coilcraft.XAL4020_222MEC;
    component R_MODEM_EN_PD: RESISTOR { value = 100kohm; footprint = "Resistor_SMD:R_0402_1005Metric"; }
    component R_MODEM_FB_TOP: RESISTOR { value = 750kohm; footprint = "Resistor_SMD:R_0402_1005Metric"; }
    component R_MODEM_FB_BOT: RESISTOR { value = 200kohm; footprint = "Resistor_SMD:R_0402_1005Metric"; }
    component C_5V: CAPACITOR { value = 10uF; footprint = "Capacitor_SMD:C_0805_2012Metric"; }
    component C_MODEM_AVIN: CAPACITOR { value = 100nF; footprint = "Capacitor_SMD:C_0402_1005Metric"; }
    component C_MODEM_SS: CAPACITOR { value = 3.3nF; footprint = "Capacitor_SMD:C_0402_1005Metric"; }
    component C_3V3: CAPACITOR { value = 22uF; footprint = "Capacitor_SMD:C_0805_2012Metric"; }
    component C_3V8: CAPACITOR { value = 22uF; footprint = "Capacitor_SMD:C_0805_2012Metric"; }
    component C_3V8_2: CAPACITOR { value = 22uF; footprint = "Capacitor_SMD:C_0805_2012Metric"; }

    net VIN5 { port.VIN5; U_LOGIC.IN; U_MODEM.AVIN; U_MODEM.PVIN_1; U_MODEM.PVIN_2; C_5V.1; C_MODEM_AVIN.1; }
    net MODEM_EN { port.MODEM_EN; U_MODEM.EN; R_MODEM_EN_PD.1; }
    net MODEM_SW { U_MODEM.SW_1; U_MODEM.SW_2; U_MODEM.SW_3; L_MODEM.A; }
    net MODEM_FB { U_MODEM.FB; R_MODEM_FB_TOP.2; R_MODEM_FB_BOT.1; }
    net MODEM_SS { U_MODEM.SS_TR; C_MODEM_SS.1; }
    net GND {
        port.GND; U_LOGIC.GND;
        U_MODEM.AGND; U_MODEM.PGND_1; U_MODEM.PGND_2; U_MODEM.EP;
        U_MODEM.FSW; U_MODEM.DEF;
        R_MODEM_EN_PD.2; R_MODEM_FB_BOT.2;
        C_5V.2; C_MODEM_AVIN.2; C_MODEM_SS.2; C_3V3.2; C_3V8.2; C_3V8_2.2;
    }
    net V3V3 { port.V3V3; U_LOGIC.OUT; C_3V3.1; }
    net V3V8 { port.V3V8; L_MODEM.B; U_MODEM.VOS; R_MODEM_FB_TOP.1; C_3V8.1; C_3V8_2.1; }

    supply INPUT { voltage = 5V; net = VIN5; external = true; }
    supply LOGIC { voltage = 3.3V; net = V3V3; source = U_LOGIC.OUT; }
    // Current ERC cannot trace a regulator SW output through a passive inductor.
    // The module power-out port represents that derived source at this boundary.
    supply MODEM { voltage = 3.8V; net = V3V8; source = port.V3V8; }
    supply GROUND { voltage = 0V; net = GND; external = true; }

    constraint max_distance(C_5V.1, U_MODEM.PVIN_1) { distance = 4mm; }
    constraint max_distance(C_MODEM_AVIN.1, U_MODEM.AVIN) { distance = 2mm; }
    constraint max_distance(C_3V8, L_MODEM.B) { distance = 3mm; }
}
