// A rectangular board with two mounting holes, for the panel tests (the
// export adds a CS_MH_ footprint per hole). Not a production circuit.
board HoleBoard {
    use library "standard";
    component R1: RESISTOR { value = 1kohm; footprint = "Resistor_SMD:R_0603_1608Metric"; }
    component R2: RESISTOR { value = 1kohm; footprint = "Resistor_SMD:R_0603_1608Metric"; }
    net SIGNAL { R1.1; R2.1; }
    net GND { R1.2; R2.2; }
    mechanical {
        outline polygon { vertices = [(0mm,0mm), (40mm,0mm), (40mm,25mm), (0mm,25mm)]; }
        hole H1 { position = (5mm,5mm); diameter = 3.2mm; head_clearance_radius = 3mm; }
        hole H2 { position = (35mm,20mm); diameter = 3.2mm; head_clearance_radius = 3mm; }
    }
    constraint fixed_placement(R1) { x = 15mm; y = 12mm; rotation = 0; side = front; }
    constraint fixed_placement(R2) { x = 25mm; y = 12mm; rotation = 0; side = front; }
}
