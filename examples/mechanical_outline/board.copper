// Mechanical frontend inspection example; not a production-qualified circuit.
board MechanicalOutline {
    use library "standard";
    component R1: RESISTOR { value = 1kohm; footprint = "Resistor_SMD:R_0603_1608Metric"; }
    component R2: RESISTOR { value = 1kohm; footprint = "Resistor_SMD:R_0603_1608Metric"; }
    net SIGNAL { R1.1; R2.1; }
    net GND { R1.2; R2.2; }
    mechanical {
        outline polygon {
            vertices = [(0mm,0mm), (60mm,0mm), (60mm,25mm), (35mm,25mm), (35mm,45mm), (0mm,45mm)];
        }
        cutout window polygon {
            vertices = [(23mm,12mm), (30mm,12mm), (30mm,18mm), (23mm,18mm)];
        }
        hole H1 { position = (5mm,5mm); diameter = 3.2mm; head_clearance_radius = 3mm; }
        hole H2 { position = (5mm,40mm); diameter = 3.2mm; head_clearance_radius = 3mm; }
    }
    constraint fixed_placement(R1) { x = 15mm; y = 10mm; rotation = 45; side = front; }
    constraint fixed_placement(R2) { x = 45mm; y = 10mm; rotation = 0; side = front; }
}
