// A four-switch buck-boost (TPS63020 style) with fixed placements, for `copper emi-check`.
// Run: copper emi-check examples/emi_buck_boost/board.copper --allow-proxy-footprints
// The cell has two hot loops: the input loop (CIN, VIN, PGND) and the output loop (COUT, VOUT, PGND).
// COUT is placed farther from the regulator than CIN so the two loops differ.
board EmiBuckBoost {
    import p "./parts";

    component U1: p.BuckBoost { footprint = "QFN-6"; }
    component L1: p.Inductor { value = 1uH; footprint = "L_1210"; }
    component CIN: p.Cap { value = 10uF; footprint = "C_0805"; role = decoupling; decouples = U1.VIN; }
    component COUT: p.Cap { value = 22uF; footprint = "C_0805"; role = decoupling; decouples = U1.VOUT; }
    component R1: p.Res { value = 100kohm; footprint = "R_0402"; }
    component R2: p.Res { value = 33kohm; footprint = "R_0402"; }
    component J1: p.Conn { footprint = "PinHeader_1x02"; }

    supply VIN { net = VIN; voltage = 3.7V; external = true; }
    supply VOUT { net = VOUT; voltage = 5V; source = U1.VOUT; }
    supply GND { net = GND; voltage = 0V; external = true; }

    net VIN { U1.VIN; CIN.A; }
    net GND { U1.PGND; CIN.B; COUT.B; R2.B; J1.B; }
    net SW1 { U1.L1; L1.A; }
    net SW2 { U1.L2; L1.B; }
    net VOUT { U1.VOUT; COUT.A; R1.A; J1.A; }
    net FB { U1.FB; R1.B; R2.A; }

    constraint copper_zone(GND) { layers = "In1.Cu"; }
    constraint emission(J1) { standard = "cispr32_class_b"; }

    constraint fixed_placement(U1) { x = 30mm; y = 30mm; rotation = 0; }
    constraint fixed_placement(CIN) { x = 24.5mm; y = 28mm; rotation = 180; }
    constraint fixed_placement(COUT) { x = 35.5mm; y = 24mm; rotation = 0; }
    constraint fixed_placement(L1) { x = 30mm; y = 38mm; rotation = 0; }
    constraint fixed_placement(R1) { x = 36mm; y = 33mm; rotation = 0; }
    constraint fixed_placement(R2) { x = 60mm; y = 60mm; rotation = 0; }
    constraint fixed_placement(J1) { x = 70mm; y = 30mm; rotation = 0; }
}
