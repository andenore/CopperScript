{"send": {"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "{root_uri}/examples/hierarchical_board/board.copper", "languageId": "copper", "version": 1, "text": "// A board that instantiates the reusable buck supply as one hierarchical unit.\nboard HierarchicalSensorBoard {\n    use library \"tiny\";\n    import power \"github.com/copperscript/examples/power\";\n    import sensors \"github.com/copperscript/examples/sensors\";\n    import stm32 \"github.com/copperscript/examples/stm32\";\n\n    component PS1: VOLTAGE_SOURCE;\n    module PWR: power.Buck5VTo3V3;\n\n    component U1: stm32.STM32G0B1CBT6 {\n        footprint = \"LQFP-48\";\n    }\n    component U2: sensors.BME280 {\n        footprint = \"LGA-8\";\n    }\n    component R1: RESISTOR {\n        value = 4.7kohm;\n        footprint = \"0402\";\n    }\n    component R2: RESISTOR {\n        value = 4.7kohm;\n        footprint = \"0402\";\n    }\n    component C1: CAPACITOR {\n        value = 100nF;\n        footprint = \"0402\";\n    }\n\n    configure U1.I2C1 as SENSOR_BUS {\n        SDA = PB7;\n        SCL = PB6;\n    }\n\n    net VBUS {\n        PS1.OUT;\n        PWR.VIN;\n    }\n    net GND {\n        PS1.GND;\n        PWR.GND;\n        U1.VSS;\n        U2.GND;\n        C1.2;\n    }\n    net V3V3 {\n        PWR.VOUT;\n        U1.VDD;\n        U2.VDD;\n        R1.1;\n        R2.1;\n        C1.1;\n    }\n    net I2C_SDA {\n        U1.PB7;\n        U2.SDA;\n        R1.2;\n    }\n    net I2C_SCL {\n        U1.PB6;\n        U2.SCL;\n        R2.2;\n    }\n\n    supply VBUS {\n        voltage = 5V;\n        source = PS1.OUT;\n    }\n    supply V3V3 {\n        voltage = 3.3V;\n        external = true;\n    }\n    supply GND {\n        voltage = 0V;\n        external = true;\n    }\n\n    interface SENSOR_I2C: i2c {\n        sda = I2C_SDA;\n        scl = I2C_SCL;\n        pullup = V3V3;\n        bind U1 { sda = PB7; scl = PB6; }\n        bind U2 { sda = SDA; scl = SCL; }\n    }\n\n    constraint max_distance(C1, U1.VDD) {\n        distance = 3mm;\n    }\n}\n"}}}}
