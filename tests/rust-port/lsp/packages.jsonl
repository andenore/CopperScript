{"send": {"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "{root_uri}/examples/packages/power/buck_5v_to_3v3.copper", "languageId": "copper", "version": 1, "text": "// Reusable 5 V to 3.3 V buck-regulator module.\n// Component values are illustrative and must be validated for production.\nmodule Buck5VTo3V3 {\n    use library \"tiny\";\n\n    port VIN: power_in;\n    port VOUT: power_out;\n    port EXTRA: passive;\n    port GND: power_in;\n\n    component U1: BUCK_REGULATOR {\n        value = \"5 V to 3.3 V buck\";\n        footprint = \"SOT-23-5\";\n    }\n    component L1: INDUCTOR {\n        value = 10uH;\n        footprint = \"L_4x4mm\";\n    }\n    component D1: SCHOTTKY_DIODE {\n        value = \"40 V Schottky\";\n        footprint = \"SOD-123\";\n    }\n    component C_IN: CAPACITOR { value = 10uF; footprint = \"0603\"; }\n    component C_OUT: CAPACITOR { value = 22uF; footprint = \"0603\"; }\n    component R_TOP: RESISTOR { value = 100kohm; footprint = \"0402\"; }\n    component R_BOTTOM: RESISTOR { value = 31.6kohm; footprint = \"0402\"; }\n\n    net VIN { port.VIN; U1.VIN; U1.EN; C_IN.1; }\n    net GND { port.GND; U1.GND; C_IN.2; C_OUT.2; D1.A; R_BOTTOM.2; }\n    net SWITCH { U1.SW; L1.1; D1.K; }\n    net VOUT { port.VOUT; L1.2; C_OUT.1; R_TOP.1; }\n    net FEEDBACK { U1.FB; R_TOP.2; R_BOTTOM.1; }\n\n    supply INPUT_RAIL { voltage = 5V; net = VIN; external = true; }\n    supply OUTPUT_RAIL { voltage = 3.3V; net = VOUT; external = true; }\n    supply GROUND_RAIL { voltage = 0V; net = GND; external = true; }\n\n    constraint max_distance(C_IN, U1.VIN) { distance = 3mm; }\n    constraint max_distance(C_OUT, L1.2) { distance = 4mm; }\n}\n"}}}}
