{"send": {"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "{root_uri}/examples/tps62130a_macro/board.copper", "languageId": "copper", "version": 1, "text": "// Isolated 1.2 V regulator geometry probe; no current/thermal/assembly qualification.\nboard BuckLayoutTrial {\n    import buck \"github.com/andenore/CopperLib/packages/circuits/ti/tps62130a-buck\";\n    import passives \"github.com/andenore/CopperLib/packages/generic/passives\";\n    // Same copper as the pinned library asset, with the existing managed-footprint adaptation.\n    import buck_layout \"github.com/andenore/CopperLib/packages/circuits/ti/tps62130a-buck\";\n\n    module B: buck.TPS62130A_BUCK_2U2;\n    component R_TOP: passives.RESISTOR { value = 49.9kohm; footprint = \"Resistor_SMD:R_0402_1005Metric\"; }\n    component R_BOT: passives.RESISTOR { value = 100kohm; footprint = \"Resistor_SMD:R_0402_1005Metric\"; }\n\n    net VIN { B.VIN; B.EN; }\n    net FB { B.FB; R_TOP.P2; R_BOT.P1; }\n    net VOUT { B.VOUT; R_TOP.P1; }\n    net GND { B.GND; R_BOT.P2; }\n    supply VIN { voltage = 5V; external = true; }\n    supply VOUT { voltage = 1.2V; source = B.VOUT; }\n    supply GND { voltage = 0V; external = true; }\n\n    constraint copper_zone(GND) { layers = \"In1.Cu,In4.Cu\"; pad_connection = solid; }\n    constraint via_in_pad(B/U.EP) { process = \"filled-capped\"; }\n    constraint routing(VIN) { width = 0.25mm; }\n    constraint routing(VOUT) { width = 0.25mm; }\n\n    physical_macro regulator: buck_layout.TPS62130A_MANAGED_ALWAYS_ON {\n        member C_AVIN = B/C_AVIN;\n        member C_OUT1 = B/C_OUT1;\n        member C_OUT2 = B/C_OUT2;\n        member C_PVIN = B/C_PVIN;\n        member C_SS = B/C_SS;\n        member L = B/L;\n        member R_FB_BOT = R_BOT;\n        member R_FB_TOP = R_TOP;\n        member U = B/U;\n        net FB = FB;\n        net GND = GND;\n        net SS = B/SS;\n        net SW = B/SW;\n        net VIN = VIN;\n        net VOUT = VOUT;\n    }\n}\n"}}}}
