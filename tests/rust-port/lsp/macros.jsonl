{"send": {"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "{root_uri}/examples/macro_definition/layouts/link.copper", "languageId": "copper", "version": 1, "text": "macro TestLayout {\n    source = \"Synthetic exact-copper authoring demonstration\";\n    unresolved = [\"Not a qualified circuit or fabrication asset\"];\n    anchor = chip;\n    allowed_rotations = [0 deg, 45 deg, 90 deg];\n    required_layers = [\"F.Cu\", \"B.Cu\"];\n\n    import land \"../test.kicad_mod\";\n    net signal;\n    member chip { footprint = land; at = (0 mm, 0 mm); }\n    member passive { footprint = land; at = (2 mm, 0 mm); }\n    pad chip.\"1\" = signal;\n    pad passive.\"1\" = signal;\n\n    track link {\n        net = signal;\n        layer = \"F.Cu\";\n        width = 0.2 mm;\n        points = [chip.\"1\", passive.\"1\"];\n    }\n    port access {\n        net = signal;\n        layer = \"F.Cu\";\n        point = chip.\"1\";\n        pads = [chip.\"1\", passive.\"1\"];\n    }\n    protected_region private {\n        layers = [\"F.Cu\"];\n        vertices = [(1 mm, -0.5 mm), (3 mm, -0.5 mm),\n                    (3 mm, 0.5 mm), (1 mm, 0.5 mm)];\n        block_zones = false;\n    }\n}\n"}}}}
