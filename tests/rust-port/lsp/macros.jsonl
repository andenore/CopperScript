{"send": {"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "{root_uri}/examples/full_vertical/board.copper", "languageId": "copper", "version": 1, "text": "// Full-vertical acceptance design: source language -> electrical IR/ERC ->\n// physical IR -> KiCad PCB -> manufacturing outputs. Values and RF networks\n// remain subject to schematic/layout review before fabrication.\nboard FullVerticalTracker {\n    use library \"tiny\";\n    import gct_usb \"github.com/andenore/CopperLib/packages/parts/gct/usb4135\";\n    import tusb \"github.com/andenore/CopperLib/packages/parts/ti/tusb320lai\";\n    import st_mcu \"github.com/andenore/CopperLib/packages/parts/st/stm32g0c1\";\n    import ti_can \"github.com/andenore/CopperLib/packages/parts/ti/tcan334g\";\n    import quectel \"github.com/andenore/CopperLib/packages/parts/quectel/eg800g-eu\";\n    import nordic \"github.com/andenore/CopperLib/packages/parts/nordic/nrf52832\";\n    import st_accel \"github.com/andenore/CopperLib/packages/parts/st/lis2dw12\";\n    import ublox \"github.com/andenore/CopperLib/packages/parts/u-blox/max-m10s\";\n    import coilcraft \"github.com/andenore/CopperLib/packages/parts/coilcraft/0603usb\";\n    import gct_sim \"github.com/andenore/CopperLib/packages/parts/gct/sim8060\";\n    import johanson \"github.com/andenore/CopperLib/packages/parts/johanson/2450at18a0100001e\";\n    import generic_can \"github.com/andenore/CopperLib/packages/generic/can-connector\";\n    import generic_ufl \"github.com/andenore/CopperLib/packages/generic/u-fl-connector\";\n    import generic_debug \"github.com/andenore/CopperLib/packages/generic/debug-uart-header\";\n    import generic_switch \"github.com/andenore/CopperLib/packages/generic/switch-button\";\n    import generic_led \"github.com/andenore/CopperLib/packages/generic/led-0603\";\n    import swd \"github.com/andenore/CopperLib/packages/interfaces/arm/swd-10pin\";\n    import vertical_support \"github.com/copperscript/examples/vertical_support\";\n\n    import modem_buck_layout \"github.com/andenore/CopperLib/packages/circuits/ti/tps62130a-buck\";\n    import nordic_layout \"github.com/andenore/CopperLib/packages/circuits/nordic/nrf52832-johanson-reference\";\n\n    component J_POWER: gct_usb.GCT_USB4135_GF_A;\n    component U_CC: tusb.TUSB320LAI;\n    module PWR: vertical_support.FullVerticalPowerTree;\n\n    component U_MCU: st_mcu.STM32G0C1RET6;\n    component U_CAN: ti_can.TCAN334G;\n    component U_MODEM: quectel.EG800G_EU;\n    component U_MODEM_LEVEL: vertical_support.DUAL_UART_LEVEL_SHIFTER;\n    component U_MODEM_KEY: vertical_support.OPEN_DRAIN_DRIVER;\n    component U_NRF: nordic.NRF52832_QFAA;\n    component U_ACCEL: st_accel.LIS2DW12;\n    component U_GNSS: ublox.MAX_M10S_00B;\n    component FL_USB: coilcraft.COILCRAFT_0603USB_601MLC;\n\n    component J_CAN: generic_can.CAN_CONNECTOR;\n    component J_CELL: generic_ufl.RF_CONNECTOR;\n    component J_GNSS: generic_ufl.RF_CONNECTOR;\n    component J_SIM: gct_sim.SIM8060_6_0_14_00_A;\n    component J_DEBUG: generic_debug.DEBUG_UART_HEADER;\n    component J_SWD_MCU: swd.SWD_HEADER;\n    component J_SWD_NRF: swd.SWD_HEADER;\n    component ANT_BT: johanson.JOHANSON_2450AT18A0100001E;\n    component SW_USER: generic_switch.BUTTON;\n    component LED_1: generic_led.LED;\n    component LED_2: generic_led.LED;\n\n    component R_I2C_SDA: RESISTOR { value = 4.7kohm; footprint = \"Resistor_SMD:R_0402_1005Metric\"; }\n    component R_I2C_SCL: RESISTOR { value = 4.7kohm; footprint = \"Resistor_SMD:R_0402_1005Metric\"; }\n    component R_CC_VBUS: RESISTOR { value = 900kohm; footprint = \"Resistor_SMD:R_0402_1005Metric\"; }\n    component R_CC_OUT1: RESISTOR { value = 10kohm; footprint = \"Resistor_SMD:R_0402_1005Metric\"; }\n    component R_CC_OUT2: RESISTOR { value = 10kohm; footprint = \"Resistor_SMD:R_0402_1005Metric\"; }\n    component R_LED_1: RESISTOR { value = 1kohm; footprint = \"Resistor_SMD:R_0402_1005Metric\"; }\n    component R_LED_2: RESISTOR { value = 1kohm; footprint = \"Resistor_SMD:R_0402_1005Metric\"; }\n    component R_RESET_MCU: RESISTOR { value = 10kohm; footprint = \"Resistor_SMD:R_0402_1005Metric\"; }\n    component R_RESET_NRF: RESISTOR { value = 10kohm; footprint = \"Resistor_SMD:R_0402_1005Metric\"; }\n    component R_CAN_TERM: RESISTOR { value = 120ohm; footprint = \"Resistor_SMD:R_0603_1608Metric\"; }\n    component L_BT_MATCH: INDUCTOR { value = 3.9nH; footprint = \"Inductor_SMD:L_0402_1005Metric\"; }\n    component C_BT_MATCH: CAPACITOR { value = 0.8pF; footprint = \"Capacitor_SMD:C_0402_1005Metric\"; }\n    component C_ANT_SERIES: CAPACITOR { value = 1pF; footprint = \"Capacitor_SMD:C_0402_1005Metric\"; }\n    component L_ANT_SHUNT: INDUCTOR { value = 2.7nH; footprint = \"Inductor_SMD:L_0402_1005Metric\"; }\n    component L_ANT_SERIES: INDUCTOR { value = 3.9nH; footprint = \"Inductor_SMD:L_0402_1005Metric\"; }\n    component C_MCU: CAPACITOR { value = 100nF; footprint = \"Capacitor_SMD:C_0402_1005Metric\"; }\n    component C_CC: CAPACITOR { value = 1uF; footprint = \"Capacitor_SMD:C_0603_1608Metric\"; }\n    component C_NRF: CAPACITOR { value = 4.7uF; footprint = \"Capacitor_SMD:C_0603_1608Metric\"; }\n    component C_ACCEL: CAPACITOR { value = 100nF; footprint = \"Capacitor_SMD:C_0402_1005Metric\"; }\n    component C_GNSS: CAPACITOR { value = 1uF; footprint = \"Capacitor_SMD:C_0603_1608Metric\"; }\n    component C_MODEM_BULK: CAPACITOR { value = 100uF; footprint = \"Capacitor_SMD:C_1210_3225Metric\"; }\n\n    configure U_MCU.USART1 as MODEM_UART {\n        TX = PB6;\n        RX = PB7;\n    }\n    configure U_MCU.USART2 as GNSS_UART {\n        TX = PA2;\n        RX = PA3;\n    }\n    configure U_MCU.USART3 as NRF_UART {\n        TX = PB8;\n        RX = PB9;\n    }\n    configure U_MCU.USART6 as DEBUG_UART {\n        TX = PA4;\n        RX = PA5;\n    }\n    configure U_MCU.I2C2 as MOTION_I2C {\n        SDA = PA6;\n        SCL = PA7;\n    }\n    configure U_MCU.FDCAN1 as VEHICLE_CAN {\n        TX = PC5;\n        RX = PC4;\n    }\n    configure U_MCU.USB_FS as MODEM_USB {\n        DP = PA12;\n        DM = PA11;\n    }\n    configure U_NRF.UARTE0 as HOST_UART {\n        TX = P0_06;\n        RX = P0_08;\n    }\n\n    net V5 {\n        J_POWER.VBUS_A;\n        J_POWER.VBUS_B;\n        PWR.VIN5;\n        U_MODEM.USB_VBUS;\n        R_CC_VBUS.1;\n    }\n    net V3V3 {\n        PWR.V3V3;\n        U_MCU.VDD;\n        U_MCU.VBAT;\n        U_MCU.VREF_PLUS;\n        U_CC.VDD;\n        R_CC_OUT1.1;\n        R_CC_OUT2.1;\n        C_CC.1;\n        U_CAN.VCC;\n        U_MODEM_LEVEL.VCCA;\n        U_MODEM_LEVEL.OE;\n        U_NRF.VDD_1;\n        U_NRF.VDD_2;\n        U_NRF.VDD_3;\n        U_ACCEL.VDD;\n        U_ACCEL.VDD_IO;\n        U_ACCEL.CS;\n        U_GNSS.VCC;\n        U_GNSS.V_IO;\n        U_GNSS.V_BCKP;\n        J_DEBUG.VREF;\n        J_SWD_MCU.VREF;\n        J_SWD_NRF.VREF;\n        R_I2C_SDA.1;\n        R_I2C_SCL.1;\n        R_RESET_MCU.1;\n        R_RESET_NRF.1;\n        C_MCU.1;\n        C_NRF.1;\n        C_ACCEL.1;\n        C_GNSS.1;\n    }\n    net V3V8 {\n        PWR.V3V8;\n        U_MODEM.VBAT_1;\n        U_MODEM.VBAT_2;\n        C_MODEM_BULK.1;\n    }\n    net V1V8_MODEM {\n        U_MODEM.VDD_EXT;\n        U_MODEM_LEVEL.VCCB;\n    }\n    net GND {\n        J_POWER.GND_A;\n        J_POWER.GND_B;\n        J_POWER.SHIELD;\n        PWR.GND;\n        U_CC.PORT;\n        U_CC.GND;\n        U_CC.EN_N;\n        C_CC.2;\n        U_MCU.VSS;\n        U_CAN.GND;\n        U_CAN.SHDN;\n        U_CAN.STB;\n        U_MODEM.GND;\n        U_MODEM.GND_1;\n        U_MODEM.GND_27;\n        U_MODEM.GND_34;\n        U_MODEM.GND_36;\n        U_MODEM.GND_37;\n        U_MODEM.GND_40;\n        U_MODEM.GND_41;\n        U_MODEM.GND_45;\n        U_MODEM.GND_46;\n        U_MODEM.GND_47;\n        U_MODEM.GND_48;\n        U_MODEM.GND_70;\n        U_MODEM.GND_71;\n        U_MODEM.GND_72;\n        U_MODEM.GND_73;\n        U_MODEM.GND_88;\n        U_MODEM.GND_89;\n        U_MODEM.GND_90;\n        U_MODEM.GND_91;\n        U_MODEM.GND_92;\n        U_MODEM.GND_93;\n        U_MODEM.GND_94;\n        U_MODEM.GND_95;\n        U_MODEM_LEVEL.GND;\n        U_MODEM_KEY.GND;\n        U_NRF.VSS_1;\n        U_NRF.VSS_2;\n        U_NRF.VSS_EP;\n        U_ACCEL.SDO_SA0;\n        U_ACCEL.GND_1;\n        U_ACCEL.RES;\n        U_ACCEL.GND_2;\n        U_GNSS.GND_1;\n        U_GNSS.GND_2;\n        U_GNSS.GND_3;\n        J_CAN.GND;\n        J_CELL.GND;\n        J_GNSS.GND;\n        J_SIM.GND;\n        J_SIM.SHIELD;\n        J_DEBUG.GND;\n        J_SWD_MCU.GND;\n        J_SWD_MCU.GND_5;\n        J_SWD_MCU.GND_DETECT;\n        J_SWD_NRF.GND;\n        J_SWD_NRF.GND_5;\n        J_SWD_NRF.GND_DETECT;\n        SW_USER.B;\n        LED_1.K;\n        LED_2.K;\n        C_BT_MATCH.1;\n        L_ANT_SHUNT.1;\n        C_MCU.2;\n        C_NRF.2;\n        C_ACCEL.2;\n        C_GNSS.2;\n        C_MODEM_BULK.2;\n    }\n\n    net CAN_TX { U_MCU.PC5; U_CAN.TXD; }\n    net CAN_RX { U_MCU.PC4; U_CAN.RXD; }\n    net CAN_H { U_CAN.CANH; J_CAN.CANH; R_CAN_TERM.1; }\n    net CAN_L { U_CAN.CANL; J_CAN.CANL; R_CAN_TERM.2; }\n\n    net MCU_MODEM_TX { U_MCU.PB6; U_MODEM_LEVEL.A_TX; }\n    net MCU_MODEM_RX { U_MCU.PB7; U_MODEM_LEVEL.A_RX; }\n    net MODEM_UART_RX { U_MODEM_LEVEL.B_RX; U_MODEM.MAIN_RXD; }\n    net MODEM_UART_TX { U_MODEM_LEVEL.B_TX; U_MODEM.MAIN_TXD; }\n    net MODEM_PWRKEY_CTL { U_MCU.PC0; U_MODEM_KEY.IN; }\n    net MODEM_PWRKEY { U_MODEM_KEY.OUT; U_MODEM.PWRKEY; }\n    net MODEM_STATUS { U_MODEM.STATUS; U_MCU.PC1; }\n    net USB_DP_MCU { U_MCU.PA12; FL_USB.DP_IN; }\n    net USB_DM_MCU { U_MCU.PA11; FL_USB.DM_IN; }\n    net USB_DP_MODEM { FL_USB.DP_OUT; U_MODEM.USB_DP; }\n    net USB_DM_MODEM { FL_USB.DM_OUT; U_MODEM.USB_DM; }\n    net CELL_RF { U_MODEM.ANT_MAIN; J_CELL.SIGNAL; }\n    net SIM_VCC { U_MODEM.USIM_VDD; J_SIM.VCC; }\n    net SIM_RST { U_MODEM.USIM_RST; J_SIM.RST; }\n    net SIM_CLK { U_MODEM.USIM_CLK; J_SIM.CLK; }\n    net SIM_IO { U_MODEM.USIM_DATA; J_SIM.IO; }\n\n    net MCU_NRF_TX { U_MCU.PB8; U_NRF.P0_08; }\n    net MCU_NRF_RX { U_MCU.PB9; U_NRF.P0_06; }\n    net NRF_RESET { U_NRF.P0_21_NRESET; J_SWD_NRF.RESET; R_RESET_NRF.2; }\n    net NRF_SWDIO { U_NRF.SWDIO; J_SWD_NRF.SWDIO; }\n    net NRF_SWDCLK { U_NRF.SWDCLK; J_SWD_NRF.SWDCLK; }\n    // Nordic QFAA reference v1.1: C3 is shunt on the chip side of L1.\n    // Follow vendor physical C3 numbering: upper pad 1 GND, lower pad 2 ANT.\n    net NRF_RF_RAW { U_NRF.ANT; C_BT_MATCH.2; L_BT_MATCH.1; }\n    // Johanson evaluation-style tee is provisional; tune on this stackup.\n    net NRF_RF_ANT { L_BT_MATCH.2; C_ANT_SERIES.1; }\n    net ANT_TEE { C_ANT_SERIES.2; L_ANT_SHUNT.2; L_ANT_SERIES.1; }\n    net ANT_FEED { L_ANT_SERIES.2; ANT_BT.FEED; }\n\n    net GNSS_TX { U_GNSS.TXD; U_MCU.PA3; }\n    net GNSS_RX { U_GNSS.RXD; U_MCU.PA2; }\n    net GNSS_TIMEPULSE { U_GNSS.TIMEPULSE; U_MCU.PC3; }\n    net GNSS_RF { U_GNSS.RF_IN; J_GNSS.SIGNAL; }\n\n    net I2C_SDA { U_MCU.PA6; U_ACCEL.SDA; R_I2C_SDA.2; }\n    net I2C_SCL { U_MCU.PA7; U_ACCEL.SCL; R_I2C_SCL.2; }\n    net ACCEL_INT { U_ACCEL.INT1; U_MCU.PC2; }\n\n    net USER_BUTTON { U_MCU.PC13; SW_USER.A; }\n    net USER_LED_1 { U_MCU.PC6; R_LED_1.1; }\n    net USER_LED_1_A { R_LED_1.2; LED_1.A; }\n    net USER_LED_2 { U_MCU.PC7; R_LED_2.1; }\n    net USER_LED_2_A { R_LED_2.2; LED_2.A; }\n\n    net DEBUG_TX { U_MCU.PA4; J_DEBUG.TX; }\n    net DEBUG_RX { U_MCU.PA5; J_DEBUG.RX; }\n    net MCU_RESET { U_MCU.NRST; J_SWD_MCU.RESET; R_RESET_MCU.2; }\n    net MCU_SWDIO { U_MCU.PA13; J_SWD_MCU.SWDIO; }\n    net MCU_SWDCLK { U_MCU.PA14; J_SWD_MCU.SWDCLK; }\n\n    net USB_C_CC1 { J_POWER.CC1; U_CC.CC1; }\n    net USB_C_CC2 { J_POWER.CC2; U_CC.CC2; }\n    net USB_C_VBUS_DET { R_CC_VBUS.2; U_CC.VBUS_DET; }\n    net USB_C_CURRENT_1 { U_CC.OUT1; R_CC_OUT1.2; U_MCU.PC8; }\n    net USB_C_CURRENT_2 { U_CC.OUT2; R_CC_OUT2.2; U_MCU.PC9; }\n    net MODEM_EN { U_MCU.PC10; PWR.MODEM_EN; }\n\n    supply V5 { voltage = 5V; external = true; }\n    supply V3V3 { voltage = 3.3V; external = true; }\n    supply V3V8 { voltage = 3.8V; external = true; }\n    supply GND { voltage = 0V; external = true; }\n\n    power_state NORMAL {\n        V5 = on;\n        V3V3 = on;\n        V3V8 = on;\n        GND = on;\n    }\n    power_state LOGIC_ONLY {\n        V5 = on;\n        V3V3 = on;\n        V3V8 = off;\n        GND = on;\n    }\n\n    interface MOTION_BUS: i2c {\n        sda = I2C_SDA;\n        scl = I2C_SCL;\n        pullup = V3V3;\n        bind U_MCU { sda = PA6; scl = PA7; }\n        bind U_ACCEL { sda = SDA; scl = SCL; }\n    }\n\n    // Mechanical intent for the provisional 100 x 80 mm outline. Coordinates\n    // are footprint origins, x right / y down; all fixed parts are on front.\n    // Connector/antenna courtyards retain the planner's 2 mm edge clearance.\n    // Bottom-left entry: USB-C and CAN openings face the bottom edge.\n    constraint fixed_placement(J_POWER) {\n        x = 12mm; y = 74mm; rotation = 0; side = front;\n    }\n    constraint fixed_placement(J_CAN) {\n        x = 25mm; y = 72mm; rotation = 0; side = front;\n    }\n    // ANT_MAIN (pad 35) moves to the modem's north edge at this rotation.\n    // The U.FL signal land faces south, toward that pad, above the modem.\n    constraint fixed_placement(U_MODEM) {\n        x = 20mm; y = 20mm; rotation = 90; side = front;\n    }\n    constraint fixed_placement(J_CELL) {\n        x = 13.4mm; y = 6mm; rotation = 90; side = front;\n    }\n    // SIM insertion faces left; contact lands face right, toward the modem.\n    constraint fixed_placement(J_SIM) {\n        x = 10mm; y = 44mm; rotation = 270; side = front;\n    }\n    // The full RF macro places all five matching parts and ANT_BT with U_NRF.\n    // Its antenna clearance reaches the upper-right board corner.\n    constraint fixed_placement(U_NRF) {\n        x = 84mm; y = 12mm; rotation = 0; side = front;\n    }\n    // The enabled TPS62130A macro fixes the hot loop and return contacts.\n    constraint fixed_placement(PWR/U_MODEM) {\n        x = 54mm; y = 48mm; rotation = 0; side = front;\n    }\n    constraint via_in_pad(PWR/U_MODEM.EP) { process = \"filled-capped\"; }\n    constraint fixed_placement(U_GNSS) {\n        x = 86mm; y = 67mm; rotation = 0; side = front;\n    }\n    constraint max_distance(J_GNSS, U_GNSS.RF_IN) { distance = 5mm; }\n\n    constraint max_distance(C_MCU, U_MCU.VDD) { distance = 3mm; }\n    // Keep the four-line USB filter in a usable corridor between both chips.\n    constraint max_distance(FL_USB.DP_IN, U_MCU.PA12) { distance = 30mm; }\n    constraint max_distance(FL_USB.DP_OUT, U_MODEM.USB_DP) { distance = 30mm; }\n    // Leave the MCU room to move while keeping its USB pins in the upper lane.\n    constraint placement_region(U_MCU) {\n        name = \"mcu-usb-lane\"; x = 38mm; y = 14mm; width = 20mm; height = 20mm;\n    }\n    constraint max_distance(C_CC, U_CC.VDD) { distance = 3mm; }\n    constraint max_distance(C_NRF, U_NRF.VDD_1) { distance = 3mm; }\n    constraint max_distance(C_ACCEL, U_ACCEL.VDD) { distance = 3mm; }\n    constraint max_distance(C_GNSS, U_GNSS.VCC) { distance = 3mm; }\n    constraint max_distance(C_MODEM_BULK, U_MODEM.VBAT_1) { distance = 5mm; }\n\n    // Explicit critical profiles; never inferred from net names. The choke\n    // divides USB into two pairs. Width/gap/layer choices below are provisional\n    // geometric intent, NOT impedance qualification (see full-vertical docs).\n    // No invented length/skew limits or fabricated field-solver evidence.\n    // USB may transition as a matched via pair to In2.Cu, next to the\n    // In1.Cu return plane. Two vias/member allow escape and return to F.Cu.\n    // These provisional common width/gap values still need layer-specific\n    // stackup qualification. Both allowed signal layers share In1.Cu; require\n    // stitching when that reference changes, not a one-plane-only dummy via.\n    // This declared topology still does not certify actual filled continuity.\n    constraint routing(USB_DP_MCU) {\n        kind = differential; priority = 100; partner = USB_DM_MCU;\n        width = 0.18mm; pair_gap = 0.2mm; target_impedance_ohms = 90;\n        allowed_layers = \"F.Cu,In2.Cu\"; max_vias = 2;\n        require_return_vias = true; return_via_net = \"GND\";\n        return_via_policy = \"reference_change\"; shared_reference_layer = \"In1.Cu\";\n        maximum_return_via_distance = 2mm;\n    }\n    constraint routing(USB_DM_MCU) {\n        kind = differential; priority = 100; partner = USB_DP_MCU;\n        width = 0.18mm; pair_gap = 0.2mm; target_impedance_ohms = 90;\n        allowed_layers = \"F.Cu,In2.Cu\"; max_vias = 2;\n        require_return_vias = true; return_via_net = \"GND\";\n        return_via_policy = \"reference_change\"; shared_reference_layer = \"In1.Cu\";\n        maximum_return_via_distance = 2mm;\n    }\n    constraint routing(USB_DP_MODEM) {\n        kind = differential; priority = 100; partner = USB_DM_MODEM;\n        width = 0.18mm; pair_gap = 0.2mm; target_impedance_ohms = 90;\n        allowed_layers = \"F.Cu,In2.Cu\"; max_vias = 2;\n        require_return_vias = true; return_via_net = \"GND\";\n        return_via_policy = \"reference_change\"; shared_reference_layer = \"In1.Cu\";\n        maximum_return_via_distance = 2mm;\n    }\n    constraint routing(USB_DM_MODEM) {\n        kind = differential; priority = 100; partner = USB_DP_MODEM;\n        width = 0.18mm; pair_gap = 0.2mm; target_impedance_ohms = 90;\n        allowed_layers = \"F.Cu,In2.Cu\"; max_vias = 2;\n        require_return_vias = true; return_via_net = \"GND\";\n        return_via_policy = \"reference_change\"; shared_reference_layer = \"In1.Cu\";\n        maximum_return_via_distance = 2mm;\n    }\n    constraint routing(CELL_RF) {\n        kind = rf_feed; priority = 120; target_impedance_ohms = 50;\n        allowed_layers = \"F.Cu\"; max_vias = 0;\n    }\n    constraint routing(GNSS_RF) {\n        kind = rf_feed; priority = 120; target_impedance_ohms = 50;\n        allowed_layers = \"F.Cu\"; max_vias = 0;\n    }\n    // Nordic's chip-side matching geometry is not a generic 50-ohm feed.\n    // Its three-terminal chip-side net includes the shunt capacitor. The\n    // series inductor's output is the point-to-point antenna feed. Neither\n    // these profiles nor the provisional placement qualify the matching layout.\n    constraint routing(NRF_RF_RAW) {\n        kind = critical; topology = tree;\n        priority = 130; allowed_layers = \"F.Cu\"; max_vias = 0;\n    }\n    constraint routing(NRF_RF_ANT) {\n        kind = rf_feed; priority = 130;\n        target_impedance_ohms = 50; allowed_layers = \"F.Cu\"; max_vias = 0;\n    }\n\n    // Inner GND references and 3.3 V distribution. In2.Cu remains the\n    // adjacent signal layer for USB; In3.Cu supplies V3V3. The top GND zones\n    // leave the buck's private F.Cu region clear. RF keepouts exclude fill\n    // around chip matching, the feed and antenna corner.\n    // Both zones require native refill and connected-copper signoff.\n    constraint copper_zone(GND) {\n        id = \"ground-return-plane\";\n        layers = \"In1.Cu,In4.Cu\";\n        inset = 0.5mm;\n        pad_connection = solid;\n    }\n    constraint copper_zone(V3V3) {\n        id = \"logic-power-plane\";\n        layers = \"In3.Cu\";\n        inset = 0.5mm;\n        pad_connection = solid;\n        island_policy = \"remove_all\";\n    }\n    constraint copper_zone(GND) {\n        id = \"top-ground-north\"; layers = \"F.Cu\";\n        polygon_mm = \"0.5,0.5;99.5,0.5;99.5,41.6;0.5,41.6\";\n        priority = 1; pad_connection = solid; island_policy = \"remove_all\";\n    }\n    constraint copper_zone(GND) {\n        id = \"top-ground-west\"; layers = \"F.Cu\";\n        polygon_mm = \"0.5,41.0;43,41.0;43,54.0;0.5,54.0\";\n        priority = 2; pad_connection = solid; island_policy = \"remove_all\";\n    }\n    constraint copper_zone(GND) {\n        id = \"top-ground-east\"; layers = \"F.Cu\";\n        polygon_mm = \"61,41.0;99.5,41.0;99.5,54.0;61,54.0\";\n        priority = 3; pad_connection = solid; island_policy = \"remove_all\";\n    }\n    constraint copper_zone(GND) {\n        id = \"top-ground-south\"; layers = \"F.Cu\";\n        polygon_mm = \"0.5,53.6;99.5,53.6;99.5,79.5;0.5,79.5\";\n        priority = 4; pad_connection = solid; island_policy = \"remove_all\";\n    }\n\n    // Source-selected physical realizations; geometry remains in the assets.\n    physical_macro modem-buck: modem_buck_layout.TPS62130A_MANAGED_ENABLED on PWR {\n        member C_AVIN = C_MODEM_AVIN;\n        member C_OUT1 = C_3V8;\n        member C_OUT2 = C_3V8_2;\n        member C_PVIN = C_5V;\n        member C_SS = C_MODEM_SS;\n        member L = L_MODEM;\n        member R_FB_BOT = R_MODEM_FB_BOT;\n        member R_FB_TOP = R_MODEM_FB_TOP;\n        member U = U_MODEM;\n        net EN = port.MODEM_EN;\n        net FB = MODEM_FB;\n        net GND = port.GND;\n        net SS = MODEM_SS;\n        net SW = MODEM_SW;\n        net VIN = port.VIN5;\n        net VOUT = port.V3V8;\n    }\n\n    physical_macro nordic-antenna: nordic_layout.NRF52832_JOHANSON_MANAGED_SIX_LAYER {\n        member ANT = ANT_BT;\n        member C3 = C_BT_MATCH;\n        member CA = C_ANT_SERIES;\n        member L1 = L_BT_MATCH;\n        member LA = L_ANT_SHUNT;\n        member LB = L_ANT_SERIES;\n        member U1 = U_NRF;\n        net antenna = ANT_FEED;\n        net feed = NRF_RF_ANT;\n        net ground = GND;\n        net raw = NRF_RF_RAW;\n        net tee = ANT_TEE;\n    }\n}\n"}}}}
