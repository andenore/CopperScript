// Rust-port corpus input: two-layer microstrip outside the fitted coupling range; not a circuit.
board TwoLayerMicrostrip {
    use library "tiny";

    component R1: RESISTOR { footprint = "0402"; }
    component R2: RESISTOR { footprint = "0402"; }
    component R3: RESISTOR { footprint = "0402"; }
    component R4: RESISTOR { footprint = "0402"; }
    component R5: RESISTOR { footprint = "0402"; }
    component R6: RESISTOR { footprint = "0402"; }

    net CKP { R1.1; R2.1; }
    net CKN { R1.2; R2.2; }
    net D0P { R3.1; R4.1; }
    net D0N { R3.2; R4.2; }
    net GND { R5.1; R6.1; }
    net RF { R5.2; R6.2; }

    mechanical {
        outline rectangle { width = 40mm; height = 30mm; }
        stackup {
            copper F.Cu { thickness = 0.035mm; }
            dielectric CORE { thickness = 1.51mm; er = 4.5; }
            copper B.Cu { thickness = 0.035mm; }
        }
    }

    constraint copper_zone(GND) { layers = "B.Cu"; }
    constraint routing(CKP) { kind = differential; partner = CKN; width = 2.8mm; pair_gap = 0.15mm; target_impedance_ohms = 90; }
    constraint routing(CKN) { kind = differential; partner = CKP; width = 2.8mm; pair_gap = 0.15mm; target_impedance_ohms = 90; }
    constraint routing(RF) { kind = rf_feed; width = 2.9mm; allowed_layers = "F.Cu"; target_impedance_ohms = 50;
        impedance_tolerance_percent = 2; }
    constraint routing(D0P) { kind = clock; width = 0.05mm; allowed_layers = "F.Cu"; target_single_ended_ohms = 150; }
}
