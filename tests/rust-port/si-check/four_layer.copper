// Rust-port corpus input: four-layer symmetric stripline and CAN pairs; not a circuit.
board FourLayerPairs {
    use library "tiny";

    component R1: RESISTOR { footprint = "0402"; }
    component R2: RESISTOR { footprint = "0402"; }
    component R3: RESISTOR { footprint = "0402"; }
    component R4: RESISTOR { footprint = "0402"; }
    component R5: RESISTOR { footprint = "0402"; }
    component R6: RESISTOR { footprint = "0402"; }

    net CKP { R1.1; R2.1; }
    net CKN { R1.2; R2.2; }
    net D0P { R3.1; R4.1; }
    net D0N { R3.2; R4.2; }
    net GND { R5.1; R6.1; }
    net RF { R5.2; R6.2; }

    mechanical {
        outline rectangle { width = 40mm; height = 30mm; }
        stackup {
            copper F.Cu { thickness = 0.035mm; }
            dielectric P1 { thickness = 0.2104mm; er = 4.05; }
            copper In1.Cu { thickness = 0.0152mm; }
            dielectric C1 { thickness = 1.065mm; er = 4.6; }
            copper In2.Cu { thickness = 0.0152mm; }
            dielectric P2 { thickness = 0.2104mm; er = 4.05; }
            copper B.Cu { thickness = 0.035mm; }
        }
    }

    constraint copper_zone(GND) { layers = "In1.Cu,In2.Cu"; }
    constraint routing(CKP) { kind = can_bus; partner = CKN; width = 0.2mm; pair_gap = 0.2mm; target_impedance_ohms = 120; }
    constraint routing(CKN) { kind = can_bus; partner = CKP; width = 0.2mm; pair_gap = 0.2mm; target_impedance_ohms = 120; }
    constraint routing(D0P) { kind = differential; partner = D0N; width = 0.1mm; pair_gap = 0.1mm;
        allowed_layers = "In1.Cu,In2.Cu"; target_impedance_ohms = 90; target_single_ended_ohms = 55; }
    constraint routing(D0N) { kind = differential; partner = D0P; width = 0.12mm; pair_gap = 0.1mm;
        allowed_layers = "In1.Cu,In2.Cu"; target_impedance_ohms = 90; target_single_ended_ohms = 55; }
    constraint routing(RF) { kind = rf_feed; width = 3mm; allowed_layers = "In1.Cu"; target_impedance_ohms = 50; }
}
