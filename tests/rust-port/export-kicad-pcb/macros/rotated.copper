// Rust-port corpus input: a macro rotated by its anchor pose; not a circuit.
board RotatedBoard {
    import parts "./parts";
    import layouts "./layouts";
    component U1: parts.Pair;
    component C1: parts.Pair;
    component R1: parts.Pair;
    net SIG { U1.B; C1.A; R1.A; }
    net GND { U1.A; C1.B; R1.B; }
    constraint fixed_placement(U1) { x = 20 mm; y = 20 mm; rotation = 90; }
    constraint fixed_placement(C1) { x = 20 mm; y = 16 mm; rotation = 90; }
    physical_macro SET: layouts.CopperSet {
        member chip = U1;
        member cap = C1;
        net sig = SIG;
        net gnd = GND;
    }
}
