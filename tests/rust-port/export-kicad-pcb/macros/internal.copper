// Rust-port corpus input: a private macro net that is not connected; not a circuit.
board InternalBoard {
    import parts "./parts";
    import layouts "./layouts";
    component U1: parts.Pair;
    component C1: parts.Pair;
    net SIG { U1.B; C1.A; }
    constraint fixed_placement(U1) { x = 20 mm; y = 20 mm; rotation = 0; }
    constraint fixed_placement(C1) { x = 24 mm; y = 20 mm; rotation = 0; }
    physical_macro SET: layouts.Internal {
        member chip = U1;
        member cap = C1;
        net sig = SIG;
    }
}
