// Rust-port corpus input: a macro binding whose net mappings miss an asset role
// (MacroPreparationError, MAC005); not a circuit.
board NetMappingBoard {
    import parts "./parts";
    import layouts "./layouts";
    component U1: parts.Pair;
    component C1: parts.Pair;
    net SIG { U1.B; C1.A; }
    net GND { U1.A; C1.B; }
    constraint fixed_placement(U1) { x = 20 mm; y = 20 mm; rotation = 0; }
    constraint fixed_placement(C1) { x = 24 mm; y = 20 mm; rotation = 0; }
    physical_macro SET: layouts.CopperSet {
        member chip = U1;
        member cap = C1;
        net sig = SIG;
    }
}
