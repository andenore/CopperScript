// Rust-port corpus input: a macro keepout that leaves the board; not a circuit.
macro EdgeOutside {
    source = "Synthetic owner-copper fixture";
    unresolved = ["Not a qualified circuit or fabrication asset"];
    anchor = chip;
    allowed_rotations = [0 deg, 90 deg, 180 deg, 270 deg];
    required_layers = ["F.Cu", "B.Cu"];

    import pair "../pair.kicad_mod";
    net sig;
    net gnd;
    member chip { footprint = pair; at = (0 mm, 0 mm); }
    member cap { footprint = pair; at = (4 mm, 0 mm); }
    pad chip."2" = sig;
    pad cap."1" = sig;
    pad chip."1" = gnd;
    pad cap."2" = gnd;

    track link {
        net = sig;
        layer = "F.Cu";
        width = 0.25 mm;
        points = [chip."2", cap."1"];
    }
    track return {
        net = gnd;
        layer = "F.Cu";
        width = 0.3 mm;
        points = [chip."1", (-0.5 mm, 1.5 mm), (4.5 mm, 1.5 mm), cap."2"];
    }
    via stitch {
        net = gnd;
        at = (2 mm, 1.5 mm);
        size = 0.6 mm;
        drill = 0.3 mm;
        from_layer = "F.Cu";
        to_layer = "B.Cu";
        technology = none;
    }
    port signal {
        net = sig;
        layer = "F.Cu";
        point = chip."2";
        pads = [chip."2", cap."1"];
    }
    port ground {
        net = gnd;
        layer = "B.Cu";
        point = (2 mm, 1.5 mm);
        pads = [chip."1", cap."2"];
    }
    protected_region core {
        layers = ["F.Cu", "B.Cu"];
        vertices = [(0.9 mm, -1.1 mm), (3.1 mm, -1.1 mm), (3.1 mm, 0.9 mm), (0.9 mm, 0.9 mm)];
    }
    zone shield {
        net = gnd;
        layers = ["B.Cu"];
        vertices = [(1 mm, -1 mm), (3 mm, -1 mm), (3 mm, 0.8 mm), (1 mm, 0.8 mm)];
        priority = 1;
        clearance = 0.2 mm;
        minimum_width = 0.2 mm;
        pad_connection = "solid";
    }
    polygon bridge {
        net = sig;
        layer = "F.Cu";
        vertices = [(1.5 mm, -0.3 mm), (2.5 mm, -0.3 mm), (2.5 mm, 0.3 mm), (1.5 mm, 0.3 mm)];
    }
    keepout antenna {
        layers = ["F.Cu", "B.Cu"];
        vertices = [(-1 mm, -4 mm), (5 mm, -4 mm), (5 mm, -1.5 mm), (-1 mm, -1.5 mm)];
    }
    edge_opening antenna_edge {
        keepout = antenna;
        edge_indices = [0];
    }
}
