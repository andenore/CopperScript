// Rust-port corpus input: a decoupler beside a required via array owner; not a circuit.
board ViaArrayDecoupling {
    import parts "./via_arrays/parts";
    component U1: parts.Qfn;
    component C1: parts.Cap { value = 100nF; role = "decoupling"; decouples = "U1.P2"; }
    component R1: parts.Pair;
    net GND { U1.EP; U1.P4; C1.B; R1.A; }
    net V3V3 { U1.P2; C1.A; R1.B; }
    supply V3V3 { voltage = 3.3V; external = true; }
    supply GND { voltage = 0V; external = true; }
    constraint fixed_placement(U1) { x = 15 mm; y = 10 mm; rotation = 0; }
    constraint copper_zone(GND) { layers = "In1.Cu"; pad_connection = solid; }
    constraint via_in_pad(U1.EP) { process = "filled-capped"; rows = 2; columns = 2; }
}
