// Rust-port corpus input: placement rules, courtyard gaps and back-side parts; not a circuit.
board PlacementRules {
    use library "tiny";

    component PS1: VOLTAGE_SOURCE { footprint = "SOT-23"; }
    component U1: BUCK_REGULATOR { footprint = "SOT-23-5"; }
    component L1: INDUCTOR { value = 2.2uH; footprint = "1210"; }
    component D1: SCHOTTKY_DIODE { footprint = "SOD-123"; }
    component C1: CAPACITOR { value = 10uF; footprint = "0805"; }
    component C2: CAPACITOR { value = 22uF; footprint = "0805"; }
    component R1: RESISTOR { value = 100kohm; footprint = "0402"; }
    component R2: RESISTOR { value = 22kohm; footprint = "0402"; }
    component R3: RESISTOR { value = 10kohm; }

    net VIN { PS1.OUT; U1.VIN; U1.EN; C1.1; }
    net SW { U1.SW; L1.1; D1.K; }
    net VOUT { L1.2; C2.1; R1.1; }
    net FB { U1.FB; R1.2; R2.1; }
    net GND { PS1.GND; U1.GND; D1.A; C1.2; C2.2; R2.2; }

    supply VIN { voltage = 12V; source = PS1.OUT; }
    supply GND { voltage = 0V; external = true; }

    constraint fixed_placement(U1) { x = 40mm; y = 30mm; rotation = 90; }
    constraint fixed_placement(L1) { x = 46.5mm; y = 30mm; rotation = -90; side = back; }
    constraint fixed_placement(C2) { side = back; }
    constraint fixed_placement(D1) { rotation = 45.5; priority = 7; edge_clearance = 0.5mm; }
    constraint allowed_orientations(R1, R2) { values = "0, 180"; }
    constraint courtyard_gap(C1, U1) { additional = 0.25mm; }
    constraint courtyard_gap(R1) { additional = 0mm; }
    constraint courtyard_gap(R2) { additional = 1mm; }
    constraint placement_region(R1, R2) {
        name = "feedback"; x = 50mm; y = 20mm; width = 10mm; height = 10mm; side = front; courtyard_gap = 0.75mm;
    }
    constraint keepout(U1) { name = "inductor-field"; x = 30mm; y = 50mm; width = 20mm; height = 10mm; maximum_height = 2mm; }
    constraint max_distance(C1, U1.VIN) { distance = 3mm; weight = 4; }
    constraint min_distance(D1, R3) { distance = 5mm; }
    constraint align(R1, R2) { axis = y; tolerance = 0.1mm; }
    constraint placement_group(R1, R2) { name = "divider"; anchor = "R2"; priority = 9; }
}
