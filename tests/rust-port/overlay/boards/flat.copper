// Overlay fixture: two front-side parts whose nets route on one layer, so the
// native copper has no vias.
board FlatOverlay {
    use library "standard";
    component R1: RESISTOR { value = 1kohm; footprint = "Resistor_SMD:R_0603_1608Metric"; }
    component R2: RESISTOR { value = 2kohm; footprint = "Resistor_SMD:R_0603_1608Metric"; }
    net A { R1.1; R2.1; }
    net B { R1.2; R2.2; }
    mechanical {
        outline rectangle { width = 20mm; height = 15mm; }
    }
    constraint fixed_placement(R1) { x = 6mm; y = 7mm; rotation = 90; side = front; }
    constraint fixed_placement(R2) { x = 12mm; y = 7mm; rotation = 90; side = front; }
}
