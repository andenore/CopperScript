# Package inventory bytes must not depend on the checkout platform.
*.copper text eol=lf
copper.mod text eol=lf
examples/packages/**/*.kicad_mod text eol=lf
# Checksum-pinned reference assets must retain exact bytes on every platform.
*.dxf -text
# Hard-macro/reference JSON needs stable inventory and provenance bytes.
*.json text eol=lf
# Showcase illustration hashes describe exact SVG bytes on every platform.
site/assets/*.svg text eol=lf
# The site's logo copies must match the editor's bytes on every platform.
crates/copper-editor/assets/*.svg text eol=lf
